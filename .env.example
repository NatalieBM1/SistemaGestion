# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como `.env` (en la raíz del repo) y reemplaza los valores.
# Los valores de aquí son EJEMPLOS, no credenciales reales. Detalle de cada
# variable: docs/configuracion.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatorias ─────────────────────────────────────────────────────────────

# URL de PostgreSQL. En local con docker-compose: usuario/clave/base de abajo.
DATABASE_URL=postgresql://remisiones:CAMBIAR_ESTA_CLAVE@localhost:5432/remisiones

# Clave para firmar los JWT y los códigos de recuperación (mínimo 32
# caracteres aleatorios). Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_48_CARACTERES

# Contraseña del usuario administrador inicial (solo la usa seed_auth.py la
# primera vez). Cámbiala desde la app al entrar.
ADMIN_INITIAL_PASSWORD=CAMBIAR_ESTA_CLAVE

# ── Entorno y red ────────────────────────────────────────────────────────────

# "development" muestra /docs y no envía HSTS; cualquier otro valor = producción.
APP_ENV=development

# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Base de datos local (docker-compose.yml) ────────────────────────────────
# Las usa docker-compose al crear el contenedor de Postgres; deben coincidir
# con DATABASE_URL.
DB_USER=remisiones
DB_PASSWORD=CAMBIAR_ESTA_CLAVE
DB_NAME=remisiones

# Pool de conexiones (Render free: máximo 25 conexiones en total).
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=7

# ── Datos de la empresa en el recibo ─────────────────────────────────────────
EMPRESA_NIT=900000000
EMPRESA_RESOLUCION_HABILITACION=Res. Habilitación 000 de Enero 1/2000

# ── Correo saliente (recuperación de contraseña) ─────────────────────────────
# Gmail: activar verificación en dos pasos y usar una "contraseña de
# aplicación" de 16 letras (no la contraseña normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo-del-sistema@ejemplo.com
SMTP_PASSWORD=CAMBIAR_ESTA_CLAVE
SMTP_FROM_NAME=Nombre de la empresa
SMTP_FROM_EMAIL=correo-del-sistema@ejemplo.com
# Minutos de validez del código de recuperación.
RESET_TOKEN_EXPIRE_MINUTES=15

# ── Límite de intentos (login y recuperación) ────────────────────────────────
RATE_LIMIT_ENABLED=true
# "memory://" sirve con un solo proceso; con varias instancias, un Redis.
RATE_LIMIT_STORAGE_URI=memory://
